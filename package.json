{
  "name": "smartagriai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:weather && npm run test:disease && npm run test:dashboard && npm run test:telegram && tsx --test src/lib/irrigation.test.ts src/app/api/pots/**/irrigation/route.test.ts",
    "test:weather": "tsx --test tests/weather.test.ts",
    "test:disease": "tsx --test src/lib/disease-images.test.ts src/app/api/disease-detection/analyze/route.test.ts src/app/api/disease-detection/reports/route.test.ts",
    "test:dashboard": "tsx --test src/lib/garden-alerts.test.ts tests/garden-dashboard-api.test.ts src/app/api/gardens/overview/route.test.ts",
    "test:telegram": "tsx --conditions=react-server --test src/lib/telegram.test.ts src/lib/business-notifications.test.ts src/lib/telegram-outbox.test.ts src/lib/device-monitoring.test.ts src/lib/telegram-preferences.test.ts src/app/api/cron/telegram-deliveries/route.test.ts src/app/api/telegram/deliveries/route.test.ts && tsx --test src/app/api/telegram/test/route.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "simulate": "node simulator.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
