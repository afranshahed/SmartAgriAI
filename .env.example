# --- Database (PostgreSQL) -------------------------------------------------
# Local Homebrew Postgres example (no password / trust auth):
DATABASE_URL="postgresql://USER@localhost:5432/smartagriai?schema=public"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"

# --- AI disease-detection microservice (FastAPI) --------------------------
# Use 127.0.0.1 (not localhost) to avoid Node fetch IPv6/IPv4 mismatch.
AI_SERVICE_URL="http://127.0.0.1:8001"

# --- Garden weather --------------------------------------------------------
# Requests are made only from the server. Open-Meteo does not require an API key.
# Override its URL only for a self-hosted provider or integration testing.
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
# Cache entries are isolated by garden ID and its exact coordinates.
WEATHER_CACHE_TTL_SECONDS="600"
# Persist one Garden weather snapshot at most once per this interval. It is
# independent from ESP32 ingestion and shared by all Pots in that Garden.
WEATHER_SNAPSHOT_INTERVAL_SECONDS="600"

# --- Disease-prediction image storage -------------------------------------
# Kept outside public/; files are served only through the authenticated image route.
DISEASE_IMAGE_UPLOAD_DIR=".data/disease-predictions"

# --- Optional local seed credentials ---------------------------------------
# Omit these to generate new one-time development credentials when seeding.
# DEMO_PASSWORD=""
# DEMO_DEVICE_KEY=""
# DEMO_DEVICE_KEY_2=""

# --- IoT simulator ----------------------------------------------------------
# DEVICE_ID is the registered Device.hardwareId, not the database Device.id.
# POT_IDS contains one or more database Pot.id values from that device's garden.
# DEVICE_ID="your-registered-hardware-id"
# DEVICE_KEY="the-one-time-device-registration-key"
# POT_IDS="your-pot-id,another-pot-id"
# API_URL="http://localhost:3000"

TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Telegram durable-delivery worker --------------------------------------
# Only required for the protected HTTP cron endpoint. The Render cron process
# calls the worker directly and does not need this value.
CRON_SECRET=change-me-to-a-random-server-only-value

# --- Device-offline monitoring ---------------------------------------------
# Configure from the deployed device's actual telemetry interval. The 900s
# A device is ONLINE through the stale threshold, STALE through the offline
# threshold, and OFFLINE afterwards. Both values use server receipt time.
DEVICE_STALE_THRESHOLD_SECONDS=60
DEVICE_OFFLINE_THRESHOLD_SECONDS=120

# --- Reliable device command lifecycle (server-only) -----------------------
DEVICE_COMMAND_ACK_TIMEOUT_SECONDS=15
DEVICE_COMMAND_RETRY_INTERVAL_SECONDS=5
DEVICE_COMMAND_MAX_ATTEMPTS=3
DEVICE_COMMAND_MAX_LIFETIME_SECONDS=30
# ESP32/simulator use the matching 60-second local relay fail-safe.
DEVICE_COMMUNICATION_LOSS_FAILSAFE_SECONDS=60

# --- Global Telegram event categories --------------------------------------
# The destination is project-wide, not linked per user. Every category
# defaults enabled; set exactly "false" to explicitly disable one.
TELEGRAM_NOTIFY_PUMP_ACKNOWLEDGED=true
TELEGRAM_NOTIFY_PUMP_FAILED=true
TELEGRAM_NOTIFY_DISEASE_ANALYSIS=true
TELEGRAM_NOTIFY_DEVICE_OFFLINE=true
TELEGRAM_NOTIFY_DEVICE_RECOVERED=true
